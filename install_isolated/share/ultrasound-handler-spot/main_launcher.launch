<?xml version="1.0"?>
<launch>

    <node name="arduino_comm" pkg="rosserial_python" type="serial_node.py"  output="screen" respawn="false" respawn_delay="0">
        <param name="port" value="/dev/ttyACM0"/>
        <param name="band" value="57600"/>
    </node>

    <node name="sonar_to_laserscan" pkg="ultrasound-handler-spot" type="range_to_laserscan_converter.py"  output="screen" respawn="false" respawn_delay="0">
        
    </node>

</launch>