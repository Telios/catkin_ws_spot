<?xml version="1.0"?>

<launch>
    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
        <rosparam file="$(find move_base)/move_base_configs/costmap_common_params.yaml" command="load" ns="global_costmap" /> 
        <rosparam file="$(find move_base)/move_base_configs/costmap_common_params.yaml" command="load" ns="local_costmap" />
        <rosparam file="$(find move_base)/move_base_configs/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find move_base)/move_base_configs/global_costmap_params.yaml" command="load" /> 
        <rosparam file="$(find move_base)/move_base_configs/base_local_planner_params.yaml" command="load" />
        <rosparam file="$(find move_base)/move_base_configs/global_planner_params.yaml" command="load" />
        <remap from="odom" to="spot/odometry" />
        <param name="/use_sim_time" value="true" />
    </node>
</launch> 